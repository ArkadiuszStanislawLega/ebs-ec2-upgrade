aws_region               = "eu-central-1"
name_prefix              = "oracle-ebs-scaler"
scaledown_check_schedule = "rate(30 minutes)"
log_retention_days       = 90

volumes = {
  # Volume 1: Uses all default production parameters (125 -> 1000 MB/s, 3000 -> 4000 IOPS)
  "vol-0663e1160ec359efa" = {}

  # Volume 2 (Optional): Example with custom baseline IOPS and custom thresholds
  # "vol-0123456789abcdef0" = {
  #   base_throughput           = 250
  #   high_throughput           = 1000
  #   base_iops                 = 6000
  #   high_iops                 = 6000
  #   scale_up_threshold_mbps   = 210
  #   scale_down_threshold_mbps = 160
  # }
}

tags = {
  Project     = "Oracle-EBS-AutoThroughput"
  ManagedBy   = "Terraform"
  Environment = "production"
}
